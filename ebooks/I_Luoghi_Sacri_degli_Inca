import re
from reportlab.lib.pagesizes import A4
from reportlab.lib.styles import ParagraphStyle
from reportlab.lib.units import cm
from reportlab.lib import colors
from reportlab.platypus import SimpleDocTemplate, Paragraph, Spacer, PageBreak, HRFlowable

DARK   = colors.HexColor('#0d1408')
GOLD   = colors.HexColor('#b89a5a')
MUTED  = colors.HexColor('#5a4a2a')
TEXT   = colors.HexColor('#2d1f0e')
W, H = A4

S = {
    'title': ParagraphStyle('title', fontName='Times-Bold', fontSize=26, leading=32, textColor=DARK, alignment=1, spaceAfter=8),
    'subtitle': ParagraphStyle('subtitle', fontName='Times-Italic', fontSize=12, leading=17, textColor=MUTED, alignment=1, spaceAfter=16),
    'author': ParagraphStyle('author', fontName='Times-Roman', fontSize=9, leading=13, textColor=GOLD, alignment=1, spaceAfter=4),
    'chapter': ParagraphStyle('chapter', fontName='Times-Bold', fontSize=17, leading=22, textColor=DARK, alignment=1, spaceBefore=20, spaceAfter=10),
    'chapter_sub': ParagraphStyle('chapter_sub', fontName='Times-Italic', fontSize=10.5, leading=15, textColor=MUTED, alignment=1, spaceAfter=14),
    'body': ParagraphStyle('body', fontName='Times-Roman', fontSize=10.5, leading=17, textColor=TEXT, spaceAfter=7),
    'section': ParagraphStyle('section', fontName='Times-Bold', fontSize=11, leading=15, textColor=DARK, spaceBefore=12, spaceAfter=5),
    'eyebrow': ParagraphStyle('eyebrow', fontName='Times-Roman', fontSize=8, leading=11, textColor=GOLD, alignment=1, spaceAfter=3),
    'footer': ParagraphStyle('footer', fontName='Times-Italic', fontSize=7.5, leading=11, textColor=GOLD, alignment=1),
}

def on_page(canvas, doc):
    canvas.saveState()
    canvas.setFillColor(GOLD)
    canvas.rect(2*cm, H - 1.4*cm, W - 4*cm, 0.5, fill=1, stroke=0)
    canvas.rect(2*cm, 1.1*cm, W - 4*cm, 0.5, fill=1, stroke=0)
    canvas.setFont('Times-Italic', 7.5)
    canvas.setFillColor(GOLD)
    canvas.drawCentredString(W/2, 0.65*cm, 'I Luoghi Sacri degli Inca  \u00b7  Shamanic Travels  \u00b7  shamanictravels.com')
    canvas.drawRightString(W - 2*cm, 0.65*cm, str(doc.page))
    canvas.restoreState()

with open('/home/claude/testo_clean.txt', 'r') as f:
    lines = [l.rstrip() for l in f.readlines()]

doc = SimpleDocTemplate(
    '/home/claude/luoghi-sacri-degli-inca.pdf',
    pagesize=A4,
    leftMargin=2.8*cm, rightMargin=2.8*cm,
    topMargin=2.4*cm, bottomMargin=2.1*cm,
    title='I Luoghi Sacri degli Inca',
    author='Marcello Buglione',
)

story = []
# COVER
story.append(Spacer(1, 3*cm))
story.append(Paragraph('SHAMANIC TRAVELS', S['eyebrow']))
story.append(HRFlowable(width='75%', thickness=0.5, color=GOLD, spaceBefore=8, spaceAfter=16))
story.append(Paragraph('I Luoghi Sacri degli Inca', S['title']))
story.append(Spacer(1, 0.2*cm))
story.append(Paragraph('Un viaggio attraverso Cusco, la Valle Sacra,<br/>Machu Picchu e il Lago Titicaca', S['subtitle']))
story.append(HRFlowable(width='55%', thickness=0.5, color=GOLD, spaceBefore=16, spaceAfter=16))
story.append(Paragraph('CUSCO \u00b7 VALLE SACRA \u00b7 PISAC \u00b7 MORAY', S['author']))
story.append(Paragraph('MACHU PICCHU \u00b7 TITICACA \u00b7 TIWANAKU', S['author']))
story.append(Spacer(1, 3.5*cm))
story.append(HRFlowable(width='35%', thickness=0.5, color=GOLD, spaceAfter=12))
story.append(Paragraph('MARCELLO BUGLIONE', S['author']))
story.append(Paragraph('Shamanic Travels \u00b7 shamanictravels.com', S['footer']))
story.append(PageBreak())

chapter_re = re.compile(r'^Capitolo\s+\d+', re.IGNORECASE)

# Salta riga 1 (titolo) e riga 2 (sottotitolo) — già in copertina
i = 2
while i < len(lines):
    line = lines[i]
    if not line:
        story.append(Spacer(1, 0.1*cm))
        i += 1
        continue

    safe = line.replace('&','&amp;').replace('<','&lt;').replace('>','&gt;')

    if chapter_re.match(line):
        story.append(PageBreak())
        story.append(Spacer(1, 0.8*cm))
        story.append(HRFlowable(width='55%', thickness=0.5, color=GOLD, spaceAfter=12))
        story.append(Paragraph(safe, S['chapter']))
        # eventuale sottotitolo (riga successiva corta, non è un altro capitolo)
        if i+1 < len(lines) and lines[i+1] and not chapter_re.match(lines[i+1]) and len(lines[i+1]) < 65:
            nxt = lines[i+1].replace('&','&amp;').replace('<','&lt;').replace('>','&gt;')
            story.append(Paragraph(nxt, S['chapter_sub']))
            i += 1
        story.append(HRFlowable(width='35%', thickness=0.5, color=GOLD, spaceBefore=8, spaceAfter=16))
        i += 1
        continue

    # Titoletto sezione: riga breve preceduta e seguita da riga vuota
    prev_empty = (i == 0 or not lines[i-1])
    next_empty = (i+1 >= len(lines) or not lines[i+1])
    if prev_empty and len(line) < 65 and not next_empty:
        story.append(Paragraph(safe, S['section']))
        i += 1
        continue

    story.append(Paragraph(safe, S['body']))
    i += 1

doc.build(story, onFirstPage=on_page, onLaterPages=on_page)
print("DONE")
PYEOF
