# ── ST CORE Environment Configuration ──
# Copy this file to .env and adjust values for your environment.

# --- General ---
PROJECT_NAME=ST CORE
DATABASE_URL=sqlite:///./database/shamanic.db
ADMIN_USERNAME=founder
ADMIN_PASSWORD=change_me
CONTACT_EMAIL=shamanictravels@gmail.com
SECRET_KEY=CHANGE_THIS_WITH_A_RANDOM_SECRET

# --- Email Backend ---
# Backend to use for sending emails. Options:
#   log       — ConsoleProvider, logs to console (default, no real send)
#   console   — Same as log
#   smtp      — SmtpProvider, real SMTP delivery (requires SMTP_* settings below)
#   resend    — ResendProvider stub (NOT IMPLEMENTED, returns False)
#   sendgrid  — SendgridProvider stub (NOT IMPLEMENTED, returns False)
EMAIL_BACKEND=log

# Maximum number of retry attempts for failed email sends
EMAIL_MAX_RETRIES=3

# --- SMTP Settings (only used when EMAIL_BACKEND=smtp) ---
# SMTP server hostname or IP address
SMTP_HOST=smtp.gmail.com

# SMTP server port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP authentication credentials
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# TLS/SSL settings (mutually exclusive; set one to true)
SMTP_TLS=true
SMTP_SSL=false

# Connection timeout in seconds
SMTP_TIMEOUT=30

# --- Email Identity ---
# "From" address and display name for outgoing emails
FROM_EMAIL=noreply@shamanictravels.com
FROM_NAME=ST Care
